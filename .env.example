# Chapter One Cafe Review Assistant - Example Environment Variables
# Copy this file to a new file named '.env' and fill in the values.

# NVIDIA NIM API Key (from https://build.nvidia.com)
VITE_NVIDIA_API_KEY=

# NVIDIA Model (Default: meta/llama-3.2-90b-vision-instruct)
VITE_NVIDIA_MODEL=meta/llama-3.2-90b-vision-instruct

# Google Maps Review Page URL (or Place ID)
VITE_GOOGLE_REVIEW_LINK=https://search.google.com/local/writereview?placeid=ChIJG04wC2pTDDkR_b1r2OTzf0E

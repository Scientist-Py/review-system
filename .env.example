# Chapter One Cafe Review Assistant - Example Environment Variables
# Copy this file to a new file named '.env' and fill in the values.

# NVIDIA AI NIM API Key & Model (Meta Llama 3.2 90B Vision Instruct)
VITE_NVIDIA_API_KEY=
VITE_AI_MODEL=meta/llama-3.2-90b-vision-instruct

# Gemini API Key (Optional Backup)
VITE_GEMINI_API_KEY=

# Google Maps Review Page URL or Place ID
VITE_GOOGLE_REVIEW_LINK=
